# Northgate AI Stock Predictor - Environment Configuration
# Copy this file to .env and provide your API keys if applicable.

# Financial News API Key (e.g., https://newsapi.org/)
NEWS_API_KEY=

# Alpha Vantage API Key (optional fallback data provider)
ALPHA_VANTAGE_API_KEY=

# Environment settings
ENVIRONMENT=development
LOG_LEVEL=INFO
